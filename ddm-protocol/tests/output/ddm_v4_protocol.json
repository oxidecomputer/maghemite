{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Protocol",
  "type": "object",
  "required": [
    "pull_response",
    "update"
  ],
  "properties": {
    "pull_response": {
      "$ref": "#/definitions/PullResponse"
    },
    "update": {
      "$ref": "#/definitions/Update"
    }
  },
  "definitions": {
    "ExternalMulticastIp": {
      "description": "A validated IP address for a customer-visible overlay multicast group.\n\nThe overlay multicast group is the address guests can send to and join, e.g. `233.252.0.1` or `ff0e::1`, and spans both address families. Its rack-internal underlay mapping is validated separately via `UnderlayMulticastIpv6`, with a 1:1 mapping between the two.\n\nJSON uses the ordinary IP-address string form. Deserialization rejects addresses that are not multicast, use a reserved, interface-local, or link-local scope, fall in the `ff04::/64` underlay subnet, are a reserved base or SSM null address, or carry malformed prefix-based or embedded-RP flags.",
      "type": "string",
      "format": "ip"
    },
    "IpNet": {
      "oneOf": [
        {
          "title": "v4",
          "allOf": [
            {
              "$ref": "#/definitions/Ipv4Net"
            }
          ]
        },
        {
          "title": "v6",
          "allOf": [
            {
              "$ref": "#/definitions/Ipv6Net"
            }
          ]
        }
      ],
      "x-rust-type": {
        "crate": "oxnet",
        "path": "oxnet::IpNet",
        "version": "0.1.0"
      }
    },
    "Ipv4Net": {
      "title": "An IPv4 subnet",
      "description": "An IPv4 subnet, including prefix and prefix length",
      "examples": [
        "192.168.1.0/24"
      ],
      "type": "string",
      "pattern": "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])/([0-9]|1[0-9]|2[0-9]|3[0-2])$",
      "x-rust-type": {
        "crate": "oxnet",
        "path": "oxnet::Ipv4Net",
        "version": "0.1.0"
      }
    },
    "Ipv6Net": {
      "title": "An IPv6 subnet",
      "description": "An IPv6 subnet, including prefix and subnet mask",
      "examples": [
        "fd12:3456::/64"
      ],
      "type": "string",
      "pattern": "^(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9]))\\/([0-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8])$",
      "x-rust-type": {
        "crate": "oxnet",
        "path": "oxnet::Ipv6Net",
        "version": "0.1.0"
      }
    },
    "MulticastOrigin": {
      "description": "The multicast group origin as exchanged between DDM peers.",
      "type": "object",
      "required": [
        "overlay_group",
        "underlay_group",
        "vni"
      ],
      "properties": {
        "metric": {
          "description": "The metric for path selection. Among paths of equal length, a lower value is preferred.",
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "overlay_group": {
          "description": "The overlay multicast group address (IPv4 or IPv6).",
          "allOf": [
            {
              "$ref": "#/definitions/ExternalMulticastIp"
            }
          ]
        },
        "source": {
          "description": "Optional source address for Source-Specific Multicast `(S,G)` routes. `None` for Any-Source Multicast `(*,G)` routes.",
          "default": null,
          "type": [
            "string",
            "null"
          ],
          "format": "ip"
        },
        "underlay_group": {
          "description": "The underlay multicast group address that the overlay group maps to (1:1).",
          "allOf": [
            {
              "$ref": "#/definitions/UnderlayMulticastIpv6"
            }
          ]
        },
        "vni": {
          "description": "VNI identifying the VPC/network context for this group.",
          "type": "integer",
          "format": "uint32",
          "maximum": 16777215.0,
          "minimum": 0.0
        }
      }
    },
    "MulticastPathHop": {
      "description": "A single hop in the multicast path.\n\n`router_id` identifies the hop for loop detection, and `underlay_addr` is the address replication toward this router targets.",
      "type": "object",
      "required": [
        "router_id",
        "underlay_addr"
      ],
      "properties": {
        "router_id": {
          "description": "Router identifier (i.e., the ddmd router ID, which defaults to the hostname).",
          "type": "string"
        },
        "underlay_addr": {
          "description": "The underlay address of this router (for replication targeting).",
          "type": "string",
          "format": "ipv6"
        }
      }
    },
    "MulticastPathVector": {
      "description": "A multicast group subscription announcement that propagates through DDM.",
      "type": "object",
      "required": [
        "origin",
        "path"
      ],
      "properties": {
        "origin": {
          "description": "The multicast group origin information.",
          "allOf": [
            {
              "$ref": "#/definitions/MulticastOrigin"
            }
          ]
        },
        "path": {
          "description": "The path to the current router, ordered outward from the subscriber's router (which is first in the list).",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MulticastPathHop"
          }
        }
      }
    },
    "MulticastUpdate": {
      "description": "Multicast group subscription updates.\n\nEach entry is a [`MulticastPathVector`], containing the group origin and the path used for loop detection.",
      "type": "object",
      "required": [
        "announce",
        "withdraw"
      ],
      "properties": {
        "announce": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MulticastPathVector"
          },
          "uniqueItems": true
        },
        "withdraw": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MulticastPathVector"
          },
          "uniqueItems": true
        }
      }
    },
    "PathVector": {
      "type": "object",
      "required": [
        "destination",
        "path"
      ],
      "properties": {
        "destination": {
          "$ref": "#/definitions/Ipv6Net"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PullResponse": {
      "description": "The route snapshot a peer advertises, sent in full in one response.\n\nA multicast-only pull disregards the underlay and tunnel fields.",
      "type": "object",
      "properties": {
        "multicast": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/MulticastPathVector"
          },
          "uniqueItems": true
        },
        "tunnel": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/TunnelOrigin"
          },
          "uniqueItems": true
        },
        "underlay": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/PathVector"
          },
          "uniqueItems": true
        }
      }
    },
    "TunnelOrigin": {
      "type": "object",
      "required": [
        "boundary_addr",
        "overlay_prefix",
        "vni"
      ],
      "properties": {
        "boundary_addr": {
          "type": "string",
          "format": "ipv6"
        },
        "metric": {
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "overlay_prefix": {
          "$ref": "#/definitions/IpNet"
        },
        "vni": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "TunnelUpdate": {
      "type": "object",
      "required": [
        "announce",
        "withdraw"
      ],
      "properties": {
        "announce": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TunnelOrigin"
          },
          "uniqueItems": true
        },
        "withdraw": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TunnelOrigin"
          },
          "uniqueItems": true
        }
      }
    },
    "UnderlayMulticastIpv6": {
      "description": "A validated underlay multicast IPv6 address.\n\nUnderlay multicast addresses must be within the subnet allocated by Omicron for rack-internal multicast traffic (ff04::/64). This is a subset of the admin-local scope (ff04::/16) defined in RFC 4291.",
      "type": "string",
      "format": "ipv6"
    },
    "UnderlayUpdate": {
      "type": "object",
      "required": [
        "announce",
        "withdraw"
      ],
      "properties": {
        "announce": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathVector"
          },
          "uniqueItems": true
        },
        "withdraw": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathVector"
          },
          "uniqueItems": true
        }
      }
    },
    "Update": {
      "type": "object",
      "properties": {
        "multicast": {
          "anyOf": [
            {
              "$ref": "#/definitions/MulticastUpdate"
            },
            {
              "type": "null"
            }
          ]
        },
        "tunnel": {
          "anyOf": [
            {
              "$ref": "#/definitions/TunnelUpdate"
            },
            {
              "type": "null"
            }
          ]
        },
        "underlay": {
          "anyOf": [
            {
              "$ref": "#/definitions/UnderlayUpdate"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}