  "components": {
    "schemas": {
      "Duration": {
        "type": "object",
        "properties": {
          "nanos": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "secs": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "required": [
          "nanos",
          "secs"
        ]
      },
      "EnableStatsRequest": {
        "type": "object",
        "properties": {
          "rack_id": {
            "type": "string",
            "format": "uuid"
          },
          "sled_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "rack_id",
          "sled_id"
        ]
      },
      "Error": {
        "description": "Error information from a response.",
        "type": "object",
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "request_id"
        ]
      },
      "ExternalMulticastIp": {
        "description": "A validated IP address for a customer-visible overlay multicast group.\n\nThe overlay multicast group is the address guests can send to and join, e.g. `233.252.0.1` or `ff0e::1`, and spans both address families. Its rack-internal underlay mapping is validated separately via `UnderlayMulticastIpv6`, with a 1:1 mapping between the two.\n\nJSON uses the ordinary IP-address string form. Deserialization rejects addresses that are not multicast, use a reserved, interface-local, or link-local scope, fall in the `ff04::/64` underlay subnet, are a reserved base or SSM null address, or carry malformed prefix-based or embedded-RP flags.",
        "type": "string",
        "format": "ip"
      },
      "ExternalPeers": {
        "type": "object",
        "properties": {
          "address_objects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "address_objects"
        ]
      },
      "IpNet": {
        "x-rust-type": {
          "crate": "oxnet",
          "path": "oxnet::IpNet",
          "version": "0.1.0"
        },
        "oneOf": [
          {
            "title": "v4",
            "allOf": [
              {
                "$ref": "#/components/schemas/Ipv4Net"
              }
            ]
          },
          {
            "title": "v6",
            "allOf": [
              {
                "$ref": "#/components/schemas/Ipv6Net"
              }
            ]
          }
        ]
      },
      "Ipv4Net": {
        "example": "192.168.1.0/24",
        "title": "An IPv4 subnet",
        "description": "An IPv4 subnet, including prefix and prefix length",
        "x-rust-type": {
          "crate": "oxnet",
          "path": "oxnet::Ipv4Net",
          "version": "0.1.0"
        },
        "type": "string",
        "pattern": "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])/([0-9]|1[0-9]|2[0-9]|3[0-2])$"
      },
      "Ipv6Net": {
        "example": "fd12:3456::/64",
        "title": "An IPv6 subnet",
        "description": "An IPv6 subnet, including prefix and subnet mask",
        "x-rust-type": {
          "crate": "oxnet",
          "path": "oxnet::Ipv6Net",
          "version": "0.1.0"
        },
        "type": "string",
        "pattern": "^(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9]))\\/([0-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8])$"
      },
      "MulticastOrigin": {
        "description": "The multicast group origin as exchanged between DDM peers.",
        "type": "object",
        "properties": {
          "metric": {
            "description": "The metric for path selection. Among paths of equal length, a lower value is preferred.",
            "default": 0,
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "overlay_group": {
            "description": "The overlay multicast group address (IPv4 or IPv6).",
            "allOf": [
              {
                "$ref": "#/components/schemas/ExternalMulticastIp"
              }
            ]
          },
          "source": {
            "nullable": true,
            "description": "Optional source address for Source-Specific Multicast `(S,G)` routes. `None` for Any-Source Multicast `(*,G)` routes.",
            "default": null,
            "type": "string",
            "format": "ip"
          },
          "underlay_group": {
            "description": "The underlay multicast group address that the overlay group maps to (1:1).",
            "allOf": [
              {
                "$ref": "#/components/schemas/UnderlayMulticastIpv6"
              }
            ]
          },
          "vni": {
            "description": "VNI identifying the VPC/network context for this group.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0,
            "maximum": 16777215
          }
        },
        "required": [
          "overlay_group",
          "underlay_group",
          "vni"
        ]
      },
      "MulticastPathHop": {
        "description": "A single hop in the multicast path.\n\n`router_id` identifies the hop for loop detection, and `underlay_addr` is the address replication toward this router targets.",
        "type": "object",
        "properties": {
          "router_id": {
            "description": "Router identifier (i.e., the ddmd router ID, which defaults to the hostname).",
            "type": "string"
          },
          "underlay_addr": {
            "description": "The underlay address of this router (for replication targeting).",
            "type": "string",
            "format": "ipv6"
          }
        },
        "required": [
          "router_id",
          "underlay_addr"
        ]
      },
      "MulticastRoute": {
        "description": "A multicast route learned via DDM.\n\nCarries a `MulticastOrigin` (overlay group + ff04::/64 underlay mapping) and the path vector from the originating subscriber through intermediate transit routers.",
        "type": "object",
        "properties": {
          "nexthop": {
            "description": "Underlay nexthop address (DDM peer that advertised this route). Used to associate the route with a peer for expiration.",
            "type": "string",
            "format": "ipv6"
          },
          "origin": {
            "description": "The multicast group origin information.",
            "allOf": [
              {
                "$ref": "#/components/schemas/MulticastOrigin"
              }
            ]
          },
          "path": {
            "description": "Path vector from the originating subscriber outward. Each hop records the router that redistributed this subscription announcement. Used for loop detection on pull and for future replication optimization in multi-rack topologies.",
            "default": [],
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MulticastPathHop"
            }
          }
        },
        "required": [
          "nexthop",
          "origin"
        ]
      },
      "PathVector": {
        "type": "object",
        "properties": {
          "destination": {
            "$ref": "#/components/schemas/Ipv6Net"
          },
          "path": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "destination",
          "path"
        ]
      },
      "PeerInfo": {
        "description": "Peer information with an optional interface name.",
        "type": "object",
        "properties": {
          "addr": {
            "type": "string",
            "format": "ipv6"
          },
          "host": {
            "type": "string"
          },
          "if_name": {
            "nullable": true,
            "description": "Interface name the peer was discovered on (e.g., \"tfportrear0_0\").",
            "default": null,
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/RouterKind"
          },
          "status": {
            "$ref": "#/components/schemas/PeerStatus"
          }
        },
        "required": [
          "addr",
          "host",
          "kind",
          "status"
        ]
      },
      "PeerStatus": {
        "description": "Status of a DDM peer, including how long the peer has been in its current state.",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "duration": {
                "$ref": "#/components/schemas/Duration"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Init"
                ]
              }
            },
            "required": [
              "duration",
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "duration": {
                "$ref": "#/components/schemas/Duration"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Solicit"
                ]
              }
            },
            "required": [
              "duration",
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "duration": {
                "$ref": "#/components/schemas/Duration"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Exchange"
                ]
              }
            },
            "required": [
              "duration",
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "duration": {
                "$ref": "#/components/schemas/Duration"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Expired"
                ]
              }
            },
            "required": [
              "duration",
              "type"
            ]
          }
        ]
      },
      "RouterKind": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      },
      "TunnelOrigin": {
        "type": "object",
        "properties": {
          "boundary_addr": {
            "type": "string",
            "format": "ipv6"
          },
          "metric": {
            "default": 0,
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "overlay_prefix": {
            "$ref": "#/components/schemas/IpNet"
          },
          "vni": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "required": [
          "boundary_addr",
          "overlay_prefix",
          "vni"
        ]
      },
