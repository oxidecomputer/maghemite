    "/originated_rack_prefixes": {
      "get": {
        "summary": "Get the rack prefixes originated by this router.",
        "description": "Only supported on transit routers.",
        "operationId": "get_originated_rack_prefixes",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Map_of_RackPrefixInfo",
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/components/schemas/RackPrefixInfo"
                  }
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "put": {
        "summary": "Originate rack prefixes from this router.",
        "description": "Each prefix has an optional multi-rack join address. The body is keyed by prefix so a prefix carries at most one join address. Advertising a prefix again replaces its join address. Originated prefixes not in the body are left unchanged. Only supported on transit routers.",
        "operationId": "advertise_rack_prefixes",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "Map_of_RackPrefixInfo",
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/RackPrefixInfo"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "resource updated"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "summary": "Withdraw rack prefixes originated by this router.",
        "description": "Only supported on transit routers.",
        "operationId": "withdraw_rack_prefixes",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "Set_of_Ipv6Net",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Ipv6Net"
                },
                "uniqueItems": true
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "resource updated"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
