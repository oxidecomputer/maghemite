          }
        }
      }
    },
    "/rack_prefixes": {
      "get": {
        "summary": "Get the rack prefixes this router has learned from its peers.",
        "description": "Each prefix maps to the distinct info carried by its paths, including paths that carry no multi-rack join address.",
        "operationId": "get_rack_prefixes",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Map_of_Set_of_RackPrefixInfo",
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/RackPrefixInfo"
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/stats/peer/{aobj_name}": {
      "get": {
        "summary": "Get the counters of the routing session on one address object.",
        "description": "Address object names contain a `/` (e.g. `tfportqsfp0_0/v6`), which must be percent-encoded as `%2F` in the path. Returns 404 if no session uses the address object.",
        "operationId": "get_peer_stats",
        "parameters": [
          {
            "in": "path",
            "name": "aobj_name",
            "description": "Address object name of the routing session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeerStats"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/stats/peers": {
      "get": {
        "summary": "Get the counters of the routing session on each address object.",
        "description": "Keyed by address object name.",
        "operationId": "get_peers_stats",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Map_of_PeerStats",
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/components/schemas/PeerStats"
                  }
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/sync": {
      "put": {
        "operationId": "sync",
        "responses": {
          "204": {
            "description": "resource updated"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/tunnel_endpoint": {
      "put": {
        "operationId": "advertise_tunnel_endpoints",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "Set_of_TunnelOrigin",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TunnelOrigin"
                },
                "uniqueItems": true
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "resource updated"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "withdraw_tunnel_endpoints",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "title": "Set_of_TunnelOrigin",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TunnelOrigin"
                },
                "uniqueItems": true
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "resource updated"
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/tunnel_endpoints": {
      "get": {
        "operationId": "get_tunnel_endpoints",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Set_of_TunnelRoute",
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TunnelRoute"
                  },
                  "uniqueItems": true
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Duration": {
        "type": "object",
        "properties": {
          "nanos": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "secs": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "required": [
          "nanos",
          "secs"
        ]
      },
      "EnableStatsRequest": {
        "type": "object",
        "properties": {
          "rack_id": {
            "type": "string",
            "format": "uuid"
          },
          "sled_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "rack_id",
          "sled_id"
        ]
      },
      "Error": {
        "description": "Error information from a response.",
        "type": "object",
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "request_id"
        ]
      },
      "ExternalPeers": {
        "type": "object",
        "properties": {
          "address_objects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "address_objects"
        ]
      },
      "IpNet": {
        "x-rust-type": {
          "crate": "oxnet",
          "path": "oxnet::IpNet",
          "version": "0.1.0"
        },
        "oneOf": [
          {
            "title": "v4",
            "allOf": [
              {
                "$ref": "#/components/schemas/Ipv4Net"
              }
            ]
          },
          {
            "title": "v6",
            "allOf": [
              {
                "$ref": "#/components/schemas/Ipv6Net"
              }
            ]
          }
        ]
      },
      "Ipv4Net": {
        "example": "192.168.1.0/24",
        "title": "An IPv4 subnet",
        "description": "An IPv4 subnet, including prefix and prefix length",
        "x-rust-type": {
          "crate": "oxnet",
          "path": "oxnet::Ipv4Net",
          "version": "0.1.0"
        },
        "type": "string",
        "pattern": "^(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])/([0-9]|1[0-9]|2[0-9]|3[0-2])$"
      },
      "Ipv6Net": {
        "example": "fd12:3456::/64",
        "title": "An IPv6 subnet",
        "description": "An IPv6 subnet, including prefix and subnet mask",
        "x-rust-type": {
          "crate": "oxnet",
          "path": "oxnet::Ipv6Net",
          "version": "0.1.0"
        },
        "type": "string",
        "pattern": "^(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9]))\\/([0-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8])$"
      },
      "PathVector": {
        "type": "object",
        "properties": {
          "destination": {
            "$ref": "#/components/schemas/Ipv6Net"
          },
          "path": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "destination",
          "path"
        ]
      },
      "Peer": {
        "description": "A discovered DDM peer.",
        "type": "object",
        "properties": {
          "addr": {
            "type": "string",
            "format": "ipv6"
          },
          "host": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/RouterKind"
          }
        },
        "required": [
          "addr",
          "host",
          "kind"
        ]
      },
      "PeerInfo": {
        "description": "The routing session on one address object, and its peer if one has been discovered.",
        "type": "object",
        "properties": {
          "peer": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Peer"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/PeerStatus"
          }
        },
        "required": [
          "status"
        ]
      },
      "PeerStats": {
        "description": "Counters for the routing session on one address object. The imported counts are the routes currently imported from this session's peer.",
        "type": "object",
        "properties": {
          "advertisements_received": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "advertisements_sent": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "imported_rack_prefixes": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "imported_tunnel_endpoints": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "imported_underlay_prefixes": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "peer_address_changes": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "peer_established": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "peer_expirations": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "solicitations_received": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "solicitations_sent": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "update_send_fail": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "updates_received": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "updates_sent": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "required": [
          "advertisements_received",
          "advertisements_sent",
          "imported_rack_prefixes",
          "imported_tunnel_endpoints",
          "imported_underlay_prefixes",
          "peer_address_changes",
          "peer_established",
          "peer_expirations",
          "solicitations_received",
          "solicitations_sent",
          "update_send_fail",
          "updates_received",
          "updates_sent"
        ]
      },
      "PeerStatus": {
        "description": "Status of a DDM peer, including how long the peer has been in its current state.",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "duration": {
                "$ref": "#/components/schemas/Duration"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Init"
                ]
              }
            },
            "required": [
              "duration",
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "duration": {
                "$ref": "#/components/schemas/Duration"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Solicit"
                ]
              }
            },
            "required": [
              "duration",
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "duration": {
                "$ref": "#/components/schemas/Duration"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Exchange"
                ]
              }
            },
            "required": [
              "duration",
              "type"
            ]
          },
